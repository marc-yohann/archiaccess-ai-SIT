// Archiaccess AI — Système d'Information Technique Fédéré
// Auth par mot de passe d'équipe partagé + copilote conversationnel +
// "second cerveau" du copilote (Document/DocumentChunk indexés via
// pgvector, voir CLAUDE.md). Le hub de données structurées (foncier,
// financier, réglementaire par adresse/parcelle) n'a pas encore de
// modèle — pas anticipé tant que les connecteurs eux-mêmes n'existent
// pas.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Un seul mot de passe d'équipe partagé (réutilisé de l'AEO d'Archiaccess
// Pro) — pas de comptes individuels pour l'instant. Chaque connexion crée
// une session, ce qui permet une vraie révocation côté serveur.
model Session {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  conversations Conversation[]
}

model Conversation {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([sessionId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
}

// "Second cerveau" du copilote — voir CLAUDE.md : pgvector sur cette même
// base + S3 pour le contenu brut, pas de service de base vectorielle
// séparé. Le Markdown reste le format de sortie des études ; ces modèles
// ne font qu'indexer ce contenu pour la recherche par similarité, jamais
// ne le remplacent.
model Document {
  id         String   @id @default(cuid())
  title      String
  sourceType String // ex: "etude", "reglementaire", "note" — pas d'enum figé tant que le hub de données n'a pas défini ses propres catégories
  s3Key      String // chemin du fichier Markdown source dans le bucket documents
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chunks DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  // Dimension 1024 = celle de mistral-embed, vérifiée par appel réel à
  // l'API (voir CLAUDE.md) plutôt que supposée. Prisma ne modélise pas
  // nativement le type vector : Unsupported() le laisse de côté côté
  // client, les insertions/recherches par similarité passeront par du
  // SQL brut ($queryRaw / $executeRaw) avec l'opérateur pgvector <=>.
  embedding Unsupported("vector(1024)")?
  createdAt DateTime @default(now())

  @@index([documentId])
}
