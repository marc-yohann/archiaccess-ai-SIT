// Archiaccess AI — Système d'Information Technique Fédéré
// Comptes employés individuels (remplace le mot de passe d'équipe partagé,
// voir CLAUDE.md) + copilote conversationnel + "second cerveau" du copilote
// (Document/DocumentChunk indexés via pgvector, voir CLAUDE.md). Le hub de
// données structurées (foncier, financier, réglementaire par
// adresse/parcelle) n'a pas encore de modèle — pas anticipé tant que les
// connecteurs eux-mêmes n'existent pas.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // postgis ajouté Phase 3 (2026-09-13) — vérifié compatible en local
  // avec vector (coexistent sans conflit, Postgres 16). Compatibilité
  // RDS réelle non vérifiée cette session (pas d'accès réseau à
  // l'instance) mais officiellement supportée par RDS Postgres — à
  // confirmer avant déploiement (voir le rapport).
  extensions = [vector, postgis]
}

// Compte employé individuel — remplace le mot de passe d'équipe partagé
// (voir CLAUDE.md, décision utilisateur du 2026-08-30). Créés uniquement
// par un admin (pas d'auto-inscription) : voir app/api/admin/users. Le
// tout premier compte s'auto-crée via /api/auth/bootstrap tant qu'aucun
// utilisateur n'existe encore (sinon personne ne pourrait créer le premier
// admin).
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  isAdmin            Boolean  @default(false)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  sessions      Session[]
  conversations Conversation[]
  // Phase 10 — traçabilité de création uniquement (voir Projet plus bas),
  // jamais une notion de propriété exclusive : un Projet reste visible et
  // modifiable par tout employé authentifié, même principe que Site/
  // Acteur (aucune donnée du SIT n'est aujourd'hui cloisonnée par
  // utilisateur, à l'exception de Conversation).
  projetsCrees  Projet[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
}

// "Second cerveau" du copilote — voir CLAUDE.md : pgvector sur cette même
// base + S3 pour le contenu brut, pas de service de base vectorielle
// séparé. Le Markdown reste le format de sortie des études ; ces modèles
// ne font qu'indexer ce contenu pour la recherche par similarité, jamais
// ne le remplacent.
model Document {
  id         String   @id @default(cuid())
  title      String
  sourceType String // ex: "etude", "reglementaire", "note" — pas d'enum figé tant que le hub de données n'a pas défini ses propres catégories
  s3Key      String // chemin du fichier Markdown source dans le bucket documents
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chunks DocumentChunk[]
}

model DocumentChunk {
  id         String                       @id @default(cuid())
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  // Dimension 1024 = celle de mistral-embed, vérifiée par appel réel à
  // l'API (voir CLAUDE.md) plutôt que supposée. Prisma ne modélise pas
  // nativement le type vector : Unsupported() le laisse de côté côté
  // client, les insertions/recherches par similarité passeront par du
  // SQL brut ($queryRaw / $executeRaw) avec l'opérateur pgvector <=>.
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now())

  @@index([documentId])
}

// Référentiel territorial du SIT (Phase 1 : Site/Localisation/Parcelle/
// Bâtiment — voir CLAUDE.md et l'audit du 2026-09-11). Contrairement à
// DataCacheEntry ci-dessous (blobs JSON opaques par connecteur, sans lien
// entre eux), ces modèles structurent et relient la donnée déjà
// réellement récupérée par les connecteurs existants (lib/data-sources/*)
// — aucune nouvelle source de données introduite ici, uniquement une
// couche relationnelle par-dessus ce qui est déjà vérifié réel. Un champ
// nullable resté vide signifie "aucune source réelle ne le fournit
// actuellement", jamais une valeur à deviner côté UI.

// Un SITE = un emplacement précis déjà étudié (adresse sélectionnée via
// "Recherche"). Créé/mis à jour à la sélection d'une adresse
// (selectAddress(), app/sit/page.tsx) — jamais créé à vide.
model Site {
  id        String                                @id @default(cuid())
  label     String // AddressResult.label (BAN) — ex: "12 rue de Vesle, 51100 Reims"
  citycode  String // code INSEE (BAN)
  postcode  String
  city      String
  longitude Float
  latitude  Float
  // Colonne géométrique additive (Phase 3, PostGIS) — longitude/latitude
  // restent la source de vérité et ne sont jamais retirées (compatibilité
  // préservée) ; geom est backfillée depuis ces deux colonnes et tenue à
  // jour par le code applicatif à chaque upsert. SRID 4326 = WGS84,
  // cohérent avec les coordonnées déjà produites par tous les connecteurs
  // existants. Unsupported() : Prisma ne modélise pas nativement le type
  // geometry (même principe que Unsupported("vector(1024)") sur
  // DocumentChunk.embedding) — accès via $queryRaw/$executeRaw.
  geom      Unsupported("geometry(Point, 4326)")?
  createdAt DateTime                              @default(now())
  updatedAt DateTime                              @updatedAt

  // Identifiant natif BAN (colonne "id" du fichier bulk officiel,
  // adresse.data.gouv.fr) — Phase 5C, additif. Nullable : seule
  // l'ingestion bulk (lib/ingestion/sources/ban.ts) le connaît et le
  // renseigne ; la recherche ponctuelle en direct (api-adresse.data.gouv.fr,
  // lib/data-sources/ban.ts) ne renvoie PAS ce champ dans sa réponse
  // (vérifié réellement, voir l'audit du 2026-09-14) donc les Sites créés
  // par ce chemin restent banId=null tant qu'un passage bulk ne les a pas
  // recoupés. Sert de clé de résolution pour BatimentPhysiqueSite (RNB
  // "addresses[].cle_interop_ban" est le même identifiant). PAS unique :
  // mesuré réellement sur le fichier BAN dept 51 (Phase 5B) — 163
  // doublons réels sur 216 756 lignes (0,075 %), jamais supposé unique.
  banId                 String?
  parcelleLinks         SiteParcelle[]
  unites                Unite[]
  batimentPhysiqueLinks BatimentPhysiqueSite[]
  sources               SiteSource[]
  etablissements        Etablissement[] // Phase 2 — voir modèle Etablissement plus bas
  projetLinks           ProjetSite[] // Phase 10 — voir modèle Projet plus bas
  documentSitLinks      DocumentSitSite[] // Phase 11 — voir modèle DocumentSit plus bas
  besoinLinks           BesoinSite[] // Phase 12 — voir modèle Besoin plus bas

  // Une même adresse recherchée plusieurs fois ne doit pas créer plusieurs
  // sites — un seul enregistrement mis à jour dans le temps.
  @@unique([citycode, label])
  @@index([citycode])
  @@index([banId])
}

// Comment une relation Site<->Parcelle a été obtenue — jamais présentée
// comme une certitude administrative quand elle ne l'en est pas une
// (Phase 4.5, voir CLAUDE.md et le rapport de consolidation). Vérifié
// réellement : aucun identifiant commun BAN/Cadastre n'existe dans les
// données officielles (le fichier bulk Cadastre ne porte aucune référence
// BAN) — DETERMINISTIC reste donc réservé pour un futur identifiant
// commun qu'aucune source actuelle ne fournit, jamais utilisé aujourd'hui.
// Deux méthodes spatiales RÉELLEMENT distinctes coexistent (mesure Phase
// 4.5, voir le rapport) : la recherche ponctuelle (apicarto, Phase 1)
// interroge une emprise (bbox ~20 m) autour du point et peut légitimement
// renvoyer PLUSIEURS parcelles proches sans garantie de containment exact
// (SPATIAL_NEARBY, distanceMeters renseignée quand mesurable) ; l'ingestion
// bulk (Phase 4) vérifie un containment géométrique exact via ST_Contains
// (SPATIAL_CONTAINS, fiable mais jamais présenté comme une certitude
// administrative pour autant).
enum SiteParcelleRelationMethod {
  SPATIAL_CONTAINS
  SPATIAL_NEARBY
  DETERMINISTIC
}

// Relation explicite Site<->Parcelle (Phase 4.5 — remplace l'ancien
// Parcelle.siteId scalaire, qui plafonnait une Parcelle à au plus un Site
// alors que la donnée réelle contredit cette hypothèse : une parcelle
// cadastrale contient très couramment plusieurs adresses BAN distinctes
// (immeuble collectif, lotissement...), et la recherche à la demande
// (apicarto, bbox) peut légitimement faire correspondre un Site à
// plusieurs parcelles voisines. Mesuré réellement avant cette évolution
// (voir le rapport) plutôt que supposé.
//
// Cas ambigu (un même Site géométriquement contenu par DEUX parcelles
// distinctes — constaté réellement, jamais hypothétique, voir le
// rapport Phase 4) : AUCUNE sélection arbitraire. Les DEUX candidates
// sont conservées avec ambiguous=true, visibles en observabilité
// qualité, plutôt que silencieusement résolues à une seule ou omises.
// Une relation résolue avec certitude a toujours ambiguous=false, et
// c'est alors la SEULE ligne SPATIAL_CONTAINS pour ce Site.
model SiteParcelle {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parcelleId String
  parcelle   Parcelle @relation(fields: [parcelleId], references: [id], onDelete: Cascade)

  relationMethod SiteParcelleRelationMethod
  ambiguous      Boolean                    @default(false)
  // Distance réelle (mètres) entre le point du Site et la géométrie de la
  // Parcelle — non pertinente pour SPATIAL_CONTAINS (le point est déjà
  // dans le polygone, toujours 0/null), mesurée pour SPATIAL_NEARBY
  // (résultat d'une recherche par emprise, jamais un containment garanti).
  // Laissée null pour les relations historiques migrées sans cette mesure
  // (voir la migration) plutôt que fabriquée rétroactivement.
  distanceMeters Float?

  source      String // "cadastre-etalab-bulk" (résolution différée, Phase 4.5) | "cadastre-apicarto" (à la demande, Phase 1)
  retrievedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Une paire (Site, Parcelle) n'a jamais plus d'une ligne — un
  // recalcul idempotent met à jour la ligne existante (ex: ambiguous)
  // plutôt que d'en créer une nouvelle.
  @@unique([siteId, parcelleId])
  @@index([siteId])
  @@index([parcelleId])
}

// Structure la donnée réelle du Cadastre — deux sources possibles,
// distinguées par `source` : l'API à la demande (apicarto, Phase 1,
// lib/data-sources/cadastre.ts) et l'ingestion bulk (Etalab/DGFiP,
// Phase 4, lib/ingestion/sources/cadastre.ts). Mêmes champs partagés,
// enrichis Phase 4 avec la provenance explicite (D du brief) — jamais
// aveuglément toutes les colonnes du fichier source. La relation vers
// Site vit désormais dans SiteParcelle (Phase 4.5, voir ci-dessus) — plus
// de siteId scalaire ici, une Parcelle pouvant réellement être associée à
// plusieurs Sites (mesuré, jamais supposé).
model Parcelle {
  id String @id @default(cuid())

  idu            String // identifiant cadastral officiel complet (ex: "514540000T0266") — jamais recomposé nous-mêmes quand fourni tel quel par la source
  section        String
  sectionPrefixe String
  numero         String
  contenanceM2   Float
  codeInsee      String
  // Nom de commune : absent du fichier bulk Etalab (seul le code INSEE y
  // figure, voir le rapport) — résolu via la même liste officielle réelle
  // que BAN/Géorisques (geo.api.gouv.fr), jamais fabriqué ; peut rester
  // vide si la résolution échoue.
  commune        String?
  geometry       Json // GeoJSON réel (Polygon ou MultiPolygon selon la source — jamais approximé)
  // Toujours normalisée en MultiPolygon via ST_Multi() à l'écriture (la
  // source bulk donne des Polygon simples) — colonne additive, voir
  // Site.geom (Phase 3).
  geom           Unsupported("geometry(MultiPolygon, 4326)")?

  // Provenance explicite (Phase 4, section D du brief) — jamais mélangée
  // entre les deux sources possibles.
  source         String? // "cadastre-apicarto" (Phase 1, à la demande) | "cadastre-etalab-bulk" (Phase 4)
  dataset        String? // ex: "parcelles"
  datasetVersion String? // millésime réel de la source bulk (ex: "2026-06-01")
  retrievedAt    DateTime?

  siteLinks             SiteParcelle[]
  batimentPhysiqueLinks BatimentPhysiqueParcelle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idu])
  @@index([codeInsee])
}

// Structure la donnée déjà réelle de lib/data-sources/dpe.ts (type
// DpeRecord). Renommé Batiment -> Unite en Phase 7 (migration
// 20260920140000_unite_dpe_rename, RENAME non destructif) : ce modèle
// représente en réalité une UNITÉ/LOGEMENT diagnostiquée par un DPE, PAS
// un bâtiment physique — vérifié réellement sur des données ADEME (un
// même bâtiment physique peut porter des dizaines de DPE réels distincts,
// un cas réel observé en comptant 101). "BatimentPhysique" (RNB) reste
// délibérément inchangé — déjà déployé/testé en production, renommer les
// deux modèles en une seule opération aurait été un remaniement sans
// bénéfice fonctionnel supplémentaire (décision Phase 7).
//
// anneeConstruction EXISTE réellement dans la source ADEME (vérifié
// Phase 5B — présent et rempli dans ~81 % des DPE réels inspectés).
// identifiantBan/codeInseeBan/numeroEtageAppartement/dateEtablissement/
// statutGeocodage/longitude/latitude : champs Phase 7, tous déjà extraits
// par lib/data-sources/dpe.ts (voir l'en-tête de ce fichier pour les
// limites de fiabilité réellement constatées de chacun — notamment
// identifiantBan ~95% fiable seulement, numeroEtageAppartement souvent 0
// par défaut) mais jamais persistés avant cette phase.
model Unite {
  id                     String   @id @default(cuid())
  siteId                 String
  site                   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // Nullable en théorie (une future source non-DPE pourrait ne pas en
  // avoir), mais toujours renseigné en pratique aujourd'hui — seule
  // source réelle actuelle (lib/data-sources/dpe.ts) le fournit toujours.
  // @unique : identifiant national ADEME, permet un upsert idempotent
  // plutôt que de dupliquer la ligne à chaque nouvelle recherche de la
  // même adresse.
  numeroDpe              String?  @unique
  typeBatiment           String?
  surfaceHabitable       Float?
  etiquetteEnergie       String?
  etiquetteGes           String?
  anneeConstruction      Int?
  identifiantBan         String?
  codeInseeBan           String?
  numeroEtageAppartement Int?
  dateEtablissement      String?
  statutGeocodage        String?
  longitude              Float?
  latitude               Float?
  createdAt              DateTime @default(now())

  // État de résolution vers BatimentPhysique (voir UniteBatimentPhysique
  // ci-dessous) — persisté séparément des lignes de relation elles-mêmes
  // car NOT_FOUND n'y est jamais matérialisé : sans ce champ, "jamais
  // traité" et "traité, aucun bâtiment trouvé" seraient indiscernables.
  batimentPhysiqueResolutionStatus UniteResolutionStatus   @default(PENDING)
  batimentPhysiqueResolvedAt       DateTime?
  batimentPhysiqueLinks            UniteBatimentPhysique[]

  @@index([siteId])
}

enum UniteResolutionStatus {
  PENDING
  VALID
  NOT_FOUND
  AMBIGUOUS
}

// Relation Unite <-> BatimentPhysique (Phase 7) — résolution SPATIALE
// uniquement (ST_Covers empreinte RNB / point DPE) : contrairement à
// RNB.plots/addresses, la source DPE ne fournit aucune référence directe
// vers un bâtiment physique, seulement des coordonnées (voir
// lib/data-sources/dpe.ts, champ _geopoint réel). ST_Covers plutôt que
// ST_Contains (choix explicite Phase 7) : un point DPE exactement sur la
// frontière d'une empreinte RNB doit rester résolu, pas silencieusement
// rejeté. Jamais de LIMIT 1 pour trancher une ambiguïté — voir
// lib/ingestion/sources/unite-batiment.ts.
//
// NOT_FOUND n'est jamais matérialisé en ligne ici (voir
// Unite.batimentPhysiqueResolutionStatus) : contrairement à
// BatimentPhysiqueParcelle/Site où une référence source (parcelleRef/
// addressRef) existe toujours et sert de clé naturelle non-nulle même en
// échec, aucune référence de ce type n'existe pour une résolution
// purement spatiale — une ligne batimentId=NULL casserait la contrainte
// d'unicité sur ré-exécution (NULL jamais égal à NULL en SQL).
model UniteBatimentPhysique {
  id              String           @id @default(cuid())
  uniteId         String
  unite           Unite            @relation(fields: [uniteId], references: [id], onDelete: Cascade)
  batimentId      String
  batiment        BatimentPhysique @relation(fields: [batimentId], references: [id], onDelete: Cascade)
  // VALID | AMBIGUOUS uniquement (voir commentaire ci-dessus pour NOT_FOUND).
  referenceStatus ReferenceStatus
  relationMethod  String           @default("SPATIAL_COVERS")
  source          String           @default("dpe-ademe-spatial")
  retrievedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())

  @@unique([uniteId, batimentId])
  @@index([uniteId])
  @@index([batimentId])
}

// Traçabilité (brief, section "Sources") : une ligne par connecteur déjà
// interrogé avec succès pour ce site, pour pouvoir afficher "Source :
// DVF, récupéré le [date]" plutôt qu'une donnée sans provenance.
model SiteSource {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source    String // même vocabulaire que DataCacheEntry.source ("cadastre", "dvf", "dpe"...)
  fetchedAt DateTime @default(now())

  @@unique([siteId, source])
  @@index([siteId])
}

// Domaine BÂTIMENT PHYSIQUE (Phase 5C — voir CLAUDE.md et le rapport).
// Décision de nommage explicite, documentée ici car elle s'écarte de la
// terminologie du brief : le modèle existant "Batiment" ci-dessus a été
// établi réellement comme un LOGEMENT/UNITÉ diagnostiqué (DPE ADEME),
// jamais un bâtiment physique (Phase 5, confirmé Phase 5B — jusqu'à 101
// DPE réels pour une même adresse). La consigne explicite de cette phase
// interdit de renommer "Batiment" en "Unite" MAINTENANT — ce nom reste
// donc pris. Le nouveau bâtiment physique (source RNB, voir plus bas) ne
// peut donc pas s'appeler littéralement "Batiment" sans collision ni
// confusion sémantique grave (une relation "BatimentParcelle" pointant en
// réalité vers un logement DPE serait un contresens). Choix retenu :
// "BatimentPhysique" — conserve la racine du brief, lève l'ambiguïté,
// n'entraîne AUCUNE migration destructive sur l'existant. Renommage
// complet proposé comme périmètre d'une phase dédiée future (voir le
// rapport, section "Proposition pour la prochaine phase") : à ce moment,
// Batiment (DPE) → Unite et BatimentPhysique → Batiment, en une seule
// opération cohérente plutôt que deux renommages successifs.
//
// Source : RNB (Référentiel National des Bâtiments, IGN/beta.gouv.fr,
// licence ODbL) — vérifié réel Phase 5B puis reconfirmé par téléchargement
// direct Phase 5C (https://rnb-opendata.s3.fr-par.scw.cloud/files/RNB_<dept>.csv.zip,
// dept 51 = exactement 95 915 141 octets, identique aux deux vérifications).
// Fournit un identifiant national stable (rnb_id), une géométrie réelle,
// et des références déterministes vers Cadastre ("plots") et BAN
// ("addresses") — jamais recalculées spatialement ici quand la source les
// fournit déjà (voir BatimentPhysiqueParcelle/BatimentPhysiqueSite).

// Une seule méthode existe aujourd'hui : RNB fournit ses relations
// directement (SOURCE_PROVIDED) — aucune méthode spatiale (ST_Contains...)
// n'est utilisée pour ce domaine cette phase, contrairement à
// SiteParcelleRelationMethod. Enum conservé (plutôt qu'un simple booléen)
// pour rester extensible si une future source nécessitait une relation
// recalculée.
enum BatimentRelationMethod {
  SOURCE_PROVIDED
}

// Statut de résolution d'une référence brute fournie par la source vers
// une ligne réelle déjà en base (Parcelle.idu pour "plots", Site.banId
// pour "addresses") — jamais un simple booléen "trouvé/pas trouvé" : une
// référence "non trouvée" reste une référence RÉELLEMENT FOURNIE par RNB,
// jamais interprétée comme "la relation n'existe pas" (voir le rapport,
// section observabilité). AMBIGUOUS : mesuré réellement possible pour les
// adresses (Site.banId n'est pas unique, 0,075 % de doublons réels
// constatés, voir Site.banId ci-dessus) — jamais observé pour les
// parcelles (Parcelle.idu est unique) mais l'enum reste commun aux deux
// pour ne pas dupliquer la sémantique.
enum ReferenceStatus {
  VALID
  NOT_FOUND
  INVALID_FORMAT
  AMBIGUOUS
}

// Le BÂTIMENT PHYSIQUE lui-même — identité RNB + géométrie réelle.
model BatimentPhysique {
  id             String                                   @id @default(cuid())
  // Identifiant national RNB ("rnb_id"), stable, unique — permet un
  // upsert idempotent plutôt que de dupliquer la ligne à chaque
  // réingestion (même principe que Batiment.numeroDpe/Parcelle.idu).
  rnbId          String                                   @unique
  // Géométrie flexible : RNB fournit RÉELLEMENT trois types différents
  // (mesuré sur le département 51 entier, Phase 5B et reconfirmé Phase
  // 5C : 365 271 MultiPolygon, 13 348 Polygon, 2 188 Point) — une colonne
  // typée "MultiPolygon" comme Parcelle.geom échouerait sur les lignes
  // Point (constaté réellement, voir le rapport). JAMAIS de polygone
  // fabriqué pour un bâtiment Point-only : geom reste un Point tel que
  // fourni par la source, geomType permet de le distinguer sans jamais le
  // traiter comme une empreinte réelle.
  geom           Unsupported("geometry(Geometry, 4326)")?
  // "POINT" | "POLYGON" | "MULTIPOLYGON" — lu directement depuis le
  // préfixe EWKT de la colonne source "shape" au moment de l'écriture
  // (jamais recalculé après coup, jamais deviné).
  geomType       String?
  // Valeur brute de la colonne RNB "status" — "constructed" est la SEULE
  // valeur réellement observée sur le département 51 entier (vérifié deux
  // fois, Phase 5B et Phase 5C) mais jamais supposée unique nationalement :
  // conservée telle quelle, jamais reformulée.
  status         String?
  source         String                                   @default("rnb-opendata-bulk")
  // Millésime réel : pas de date dans le chemin de l'objet S3 RNB
  // (contrairement à Cadastre) — dérivé du header HTTP "Last-Modified"
  // réel de l'objet (ex: "2026-09-12"), jamais deviné.
  datasetVersion String?
  retrievedAt    DateTime                                 @default(now())
  createdAt      DateTime                                 @default(now())
  updatedAt      DateTime                                 @updatedAt

  // Partition territoriale technique (Phase 5E — lacune identifiée Phase
  // 5D : rien ne permettait jusqu'ici de savoir "quel département" pour un
  // BatimentPhysique donné sans recouper via une jointure Parcelle/Site).
  // Valeur = le paramètre "deptCode" déjà utilisé par RnbStagingRunner/
  // RnbIngestionRunner pour construire dataset ("batiments/<deptCode>") —
  // c'est la partition RÉELLE de l'export source RNB (un fichier =
  // RNB_<deptCode>.csv.zip), jamais une géométrie approximative ni une
  // règle métier : aujourd'hui un code département INSEE parce que RNB
  // partitionne ainsi son export, mais rien ne force cette colonne à
  // rester un "département" si une source future partitionnait autrement.
  // Renseignée directement par l'application à l'écriture pour toute
  // nouvelle ingestion (priorité 1, voir lib/ingestion/sources/rnb.ts) —
  // nullable uniquement pour d'éventuelles lignes plus anciennes qui n'en
  // disposeraient pas encore (voir la migration de backfill, qui dérive
  // alors la valeur par jointure Parcelle/Site validée, JAMAIS de façon
  // arbitraire en cas de désaccord entre les deux — laissée NULL dans ce
  // cas, voir le rapport Phase 5E).
  sourcePartition String?

  parcelleLinks BatimentPhysiqueParcelle[]
  siteLinks     BatimentPhysiqueSite[]
  // Relation inverse Unite<->BatimentPhysique (Phase 7) — voir
  // UniteBatimentPhysique. Seul ajout touchant ce modèle en Phase 7,
  // strictement nécessaire côté Prisma pour la relation bidirectionnelle,
  // aucun autre champ/index de BatimentPhysique modifié.
  uniteLinks    UniteBatimentPhysique[]

  @@index([geomType])
  @@index([sourcePartition])
}

// Relation N:N Bâtiment physique <-> Parcelle, fournie NATIVEMENT par RNB
// (colonne "plots", ex: [{"id":"51609000AK0722","bdg_cover_ratio":0.123...}])
// — "plots[].id" est directement au format Parcelle.idu (vérifié
// réellement, Phase 5B). Jamais recalculée par ST_Contains quand RNB la
// fournit déjà : parcelleRef conserve la référence brute même une fois
// résolue (traçabilité), parcelleId reste NULL tant que la référence n'a
// pas été retrouvée dans le référentiel Parcelle déjà en base (jamais
// silencieusement traitée comme "pas de relation" — voir referenceStatus).
//
// Contrainte d'unicité sur (batimentId, parcelleRef) et non
// (batimentId, parcelleId) comme une lecture littérale du brief le
// suggérait : parcelleId est nullable (référence NOT_FOUND) et plusieurs
// lignes NOT_FOUND pour un même bâtiment auraient sinon pu violer une
// contrainte sur une paire contenant des NULL de façon incohérente selon
// la référence brute réellement distincte — parcelleRef, toujours
// renseigné par la source, est la vraie clé naturelle de cette relation.
model BatimentPhysiqueParcelle {
  id              String                 @id @default(cuid())
  batimentId      String
  batiment        BatimentPhysique       @relation(fields: [batimentId], references: [id], onDelete: Cascade)
  parcelleId      String?
  parcelle        Parcelle?              @relation(fields: [parcelleId], references: [id], onDelete: Cascade)
  parcelleRef     String
  relationMethod  BatimentRelationMethod @default(SOURCE_PROVIDED)
  referenceStatus ReferenceStatus
  // "plots[].bdg_cover_ratio" réel — jamais recalculé.
  coverageRatio   Float?
  source          String                 @default("rnb-opendata-bulk")
  retrievedAt     DateTime               @default(now())
  createdAt       DateTime               @default(now())

  @@unique([batimentId, parcelleRef])
  @@index([batimentId])
  @@index([parcelleId])
}

// Relation N:N Bâtiment physique <-> Site, fournie NATIVEMENT par RNB
// (colonne "addresses", ex: [{"cle_interop_ban":"51609_0540_00035",...}]).
// Résolution PAR EXACTITUDE UNIQUEMENT contre Site.banId (le même
// référentiel BAN) — AUCUN rapprochement flou cette phase (consigne
// explicite du brief) : match exact = VALID, aucun match = NOT_FOUND,
// PLUSIEURS matches = AMBIGUOUS (mesuré réellement possible, voir
// Site.banId), jamais une sélection arbitraire. Même remarque que
// BatimentPhysiqueParcelle sur le choix de la contrainte d'unicité
// (addressRef, toujours fourni, plutôt que siteId, nullable).
model BatimentPhysiqueSite {
  id              String                 @id @default(cuid())
  batimentId      String
  batiment        BatimentPhysique       @relation(fields: [batimentId], references: [id], onDelete: Cascade)
  siteId          String?
  site            Site?                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  addressRef      String
  relationMethod  BatimentRelationMethod @default(SOURCE_PROVIDED)
  referenceStatus ReferenceStatus
  source          String                 @default("rnb-opendata-bulk")
  retrievedAt     DateTime               @default(now())
  createdAt       DateTime               @default(now())

  @@unique([batimentId, addressRef])
  @@index([batimentId])
  @@index([siteId])
}

// Référentiel des acteurs du SIT (Phase 2 — voir audit du 2026-09-12).
// Même principe que Site/Parcelle/Batiment : structure et relie la
// donnée déjà réellement récupérée par lib/data-sources/entreprises.ts
// (SIRENE) et lib/data-sources/bodacc.ts — aucune nouvelle source. Un
// champ nullable signifie "aucune source réelle ne le fournit
// actuellement", jamais une valeur devinée.

// Aucune source publique ne permet de déduire ce qu'est une entreprise
// pour un projet donné (architecte, AMO, entreprise générale...) — ce
// n'est jamais assigné automatiquement, seulement par un humain, plus
// tard (pas d'interface d'assignation construite dans cette phase).
enum ActeurType {
  ARCHITECTE
  BUREAU_ETUDES
  AMO
  OPC
  ECONOMISTE
  GEOMETRE
  CONTROLEUR_TECHNIQUE
  COORDONNATEUR_SPS
  DIAGNOSTIQUEUR
  ENTREPRISE_GENERALE
  ENTREPRISE_SPECIALISEE
  FOURNISSEUR
  FABRICANT
  PROMOTEUR
  MAITRE_OUVRAGE
  ACHETEUR_PUBLIC
}

// Un ACTEUR = une entreprise (SIRENE) déjà rencontrée dans une recherche
// (recherche universelle "Recherche", catégorie ACTEUR). Identifié par
// SIREN (stable, national).
model Acteur {
  id                  String      @id @default(cuid())
  siren               String      @unique
  // Nullable : reste vide pour un Acteur connu seulement via
  // StockEtablissement (pas de dénomination à ce niveau) tant que
  // StockUniteLegale ne l'a pas encore renseigné, ou pour de rares
  // unités légales réellement purgées côté INSEE. Une fois
  // StockUniteLegale ingéré (Phase 3, 2026-09-12), rempli pour la quasi-
  // totalité des SIREN réels : denominationUniteLegale pour une personne
  // morale, prénom+nom pour une personne physique (entrepreneur
  // individuel) — jamais de valeur fabriquée pour combler l'absence
  // résiduelle. Voir lib/ingestion/sources/sirene.ts.
  nom                 String?
  nomCommercial       String?
  codeNaf             String?
  // A/C ("actif"/"cessé") — vocabulaire de l'unité légale (StockUniteLegale
  // ou l'API de recherche ponctuelle, même niveau), distinct du A/F de
  // l'établissement (voir Etablissement.actif).
  statut              String?
  dateCreation        String?
  // Champs réellement utiles au SIT depuis StockUniteLegale (D du brief
  // Phase 3) — pas une reprise aveugle de toutes les colonnes SIRENE.
  categorieJuridique  String? // code INSEE (ex: "1000" = entrepreneur individuel, "5710" = SAS...)
  categorieEntreprise String? // PME/ETI/GE — déjà capté par lib/data-sources/entreprises.ts mais jamais persisté jusqu'ici
  trancheEffectifs    String? // tranche d'effectifs salariés (code INSEE)
  type                ActeurType?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  etablissements Etablissement[]
  sources        ActeurSource[]

  // Phase 9 — capacité future uniquement : jamais rempli par une
  // résolution automatique (aucun SIREN/SIRET fiable dans BOAMP, voir
  // lib/data-sources/boamp.ts et le rapport Phase 9). Nullable partout.
  avisMarcheCommeAcheteur  AvisMarche[] @relation("AvisMarcheAcheteur")
  avisMarcheCommeTitulaire AvisMarche[] @relation("AvisMarcheTitulaire")
  lotsCommeTitulaire       Lot[]        @relation("LotTitulaire")

  // Phase 10 — voir modèle Projet plus bas.
  projetLinks      ProjetActeur[]
  // Phase 11 — voir modèle DocumentSit plus bas.
  documentSitLinks DocumentSitActeur[]
  // Phase 12 — voir modèle Besoin plus bas.
  besoinLinks      BesoinActeur[]
}

// Phase 8 — statut de résolution Etablissement→Site, même principe que
// UniteResolutionStatus (Phase 7) : PENDING distingue explicitement "jamais
// tenté" de NOT_FOUND ("tenté, aucun candidat suffisamment identifié"),
// pour ne jamais perdre cette information au fil des reprises. Backfill
// historique (migration 20260920150000) : les lignes déjà résolues
// (siteId non nul, résolution top-1 pré-Phase-8) sont marquées VALID ;
// toutes les autres PENDING — jamais NOT_FOUND, l'historique ne permet pas
// de savoir si une résolution a même été tentée.
enum EtablissementSiteResolutionStatus {
  PENDING
  VALID
  NOT_FOUND
  AMBIGUOUS
}

// Structure lib/data-sources/entreprises.ts::Company.siege une fois
// étendu (code postal, commune, coordonnées — présents dans l'API mais
// ignorés jusqu'ici, voir l'audit Phase 2). Un seul établissement par
// entreprise pour l'instant (le siège) : l'API de recherche ne renvoie
// pas la liste complète des établissements sans un appel dédié non
// encore vérifié.
model Etablissement {
  id                   String                            @id @default(cuid())
  acteurId             String
  acteur               Acteur                            @relation(fields: [acteurId], references: [id], onDelete: Cascade)
  siret                String                            @unique
  adresse              String?
  codePostal           String?
  codeInsee            String?
  commune              String?
  latitude             Float?
  longitude            Float?
  estSiege             Boolean                           @default(false)
  actif                Boolean?
  // Résolu via lib/data-sources/ban.ts::searchAddress() sur l'adresse
  // SIRENE (même mécanisme que la persistance Site de la Phase 1) — pas
  // une correspondance de texte brute. Nullable tant que la résolution
  // n'a pas réussi ou n'a pas encore été tentée.
  siteId               String?
  site                 Site?                             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  // Phase 8 — voir EtablissementSiteResolutionStatus. siteResolvedAt reste
  // nul pour les lignes historiques backfillées (date réelle de résolution
  // inconnue) — jamais une valeur approximée.
  siteResolutionStatus EtablissementSiteResolutionStatus @default(PENDING)
  siteResolvedAt       DateTime?
  createdAt            DateTime                          @default(now())

  @@index([acteurId])
  @@index([siteId])
}

// Traçabilité — même principe que SiteSource.
model ActeurSource {
  id        String   @id @default(cuid())
  acteurId  String
  acteur    Acteur   @relation(fields: [acteurId], references: [id], onDelete: Cascade)
  source    String // "entreprises", "bodacc"...
  fetchedAt DateTime @default(now())

  @@unique([acteurId, source])
  @@index([acteurId])
}

// Phase 9 — Marchés/Lots. 1 ligne = 1 AVIS/publication BOAMP, jamais un
// "marché" unique reconstitué sur tout son cycle de vie : un même marché
// réel publie en général plusieurs avis distincts dans le temps (avis
// initial, rectificatif(s), résultat), chacun avec son propre idweb —
// voir le rapport d'audit Phase 9. Un futur modèle `Marche` pourra un
// jour agréger plusieurs AvisMarche ; ce n'est pas fait ici, sur décision
// utilisateur explicite.
//
// Identité : source + sourceId (sourceId = idweb BOAMP, ex "15-31232"),
// PAS recordId (identifiant interne opendatasoft, conservé uniquement
// pour la traçabilité technique, jamais utilisé comme clé métier — voir
// lib/data-sources/boamp.ts).
model AvisMarche {
  id       String  @id @default(cuid())
  source   String  @default("boamp")
  sourceId String // idweb BOAMP — identifiant d'AVIS, pas de marché (voir ci-dessus)
  // recordId opendatasoft — traçabilité technique seulement (voir
  // ci-dessus), délibérément SANS contrainte unique pour ne jamais en
  // faire une clé implicite.
  recordId String?

  objet             String?
  // nature_libelle réel : "Avis de marché", "Résultat de marché",
  // "Avis rectificatif"... texte source, jamais normalisé arbitrairement.
  natureAvis        String?
  typeProcedure     String? // procedure_libelle / type_procedure
  typeMarche        String? // type_marche_facette : "Travaux"/"Fournitures"/"Services"...
  datePublication   String? // format source conservé tel quel (même principe qu'Acteur.dateCreation)
  dateLimiteReponse String?

  // Montant/titulaire au niveau de l'AVIS ENTIER — pertinent uniquement
  // quand l'attribution n'est pas répartie par lot (donnees.ATTRIBUTION.
  // DECISION sans NUM_LOT, vérifié réellement sur des données BOAMP
  // réelles, voir le rapport Phase 9). Quand l'avis a des lots, montant/
  // titulaire vivent sur chaque Lot à la place (voir plus bas). Ajoutés
  // en plus de la liste minimale demandée : sans titulaireNom ici, le
  // titulaire d'un marché non découpé en lots n'aurait nulle part où
  // être persisté alors que la donnée existe réellement dans la source
  // (violerait la règle "aucune perte silencieuse").
  montant       Float?
  montantDevise String?
  acheteurNom   String?
  // Capacité future uniquement (voir Acteur ci-dessus) — jamais résolu
  // automatiquement : aucun SIREN/SIRET fiable trouvé dans BOAMP sur les
  // données réelles auditées.
  acheteurId    String?
  acheteur      Acteur? @relation("AvisMarcheAcheteur", fields: [acheteurId], references: [id], onDelete: SetNull)
  titulaireNom  String?
  titulaireId   String?
  titulaire     Acteur? @relation("AvisMarcheTitulaire", fields: [titulaireId], references: [id], onDelete: SetNull)

  codeDepartement                String?
  urlAvis                        String?
  // gestion.MARCHE.ANNONCE_ANTERIEUR.REFERENCE.IDWEB réel — lien de
  // provenance INFORMATIF seulement (pas garanti présent, pas transitif
  // de façon fiable). Ne déclenche JAMAIS de fusion automatique de deux
  // AvisMarche — voir le rapport Phase 9, section "cycle de vie".
  referenceAvisAnterieurSourceId String?
  // OBJET.LIEU_EXEC_LIVR.ADRESSE — capturé seulement quand réellement
  // exploitable (pas une valeur générique type "France entière"/code
  // NUTS seul, filtré côté connecteur) ; jamais utilisé pour créer une
  // relation Site (pas fiable/systématique, voir le rapport Phase 9).
  lieuExecution                  String?

  retrievedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cpvs             AvisMarcheCpv[]
  lots             Lot[]
  // Phase 10 — voir modèle Projet plus bas.
  projetLinks      ProjetAvisMarche[]
  // Phase 11 — voir modèle DocumentSit plus bas.
  documentSitLinks DocumentSitAvisMarche[]
  // Phase 12 — voir modèle Besoin plus bas.
  besoinLinks      BesoinAvisMarche[]

  @@unique([source, sourceId])
  @@index([acheteurId])
  @@index([titulaireId])
  @@index([codeDepartement])
}

// CPV de l'AVIS (utilisé quand l'avis n'est pas découpé en lots — sinon
// le CPV vit sur chaque Lot, voir LotCpv). Table de jointure plutôt que
// colonne tableau Postgres : la source BOAMP peut fournir un CPV unique
// (objet JSON) ou plusieurs (tableau JSON) selon l'avis — un artefact de
// la conversion XML->JSON de l'API opendatasoft, vérifié réellement (voir
// lib/data-sources/boamp.ts, normalizeToArray()). Une table dédiée
// conserve TOUS les codes réels sans jamais en écraser un silencieusement,
// et reste cohérente avec le style du reste du schéma (ActeurSource,
// SiteSource...) plutôt que d'introduire un type de colonne inédit ici.
model AvisMarcheCpv {
  id           String     @id @default(cuid())
  avisMarcheId String
  avisMarche   AvisMarche @relation(fields: [avisMarcheId], references: [id], onDelete: Cascade)
  code         String

  @@unique([avisMarcheId, code])
  @@index([avisMarcheId])
}

// Un lot tel que publié DANS CET AVIS (donnees.OBJET.LOTS.LOT à l'avis
// initial, ou donnees.ATTRIBUTION.DECISION avec NUM_LOT à un résultat) —
// pas une entité indépendante du cycle de vie du marché, cohérent avec
// AvisMarche lui-même (voir plus haut). numero conservé en texte : vu
// réellement sous les deux formes "1"/"2" et "01"/"02" selon l'avis,
// jamais casté en entier (perdrait le zéro de tête).
model Lot {
  id           String     @id @default(cuid())
  avisMarcheId String
  avisMarche   AvisMarche @relation(fields: [avisMarcheId], references: [id], onDelete: Cascade)
  numero       String

  description   String?
  montant       Float?
  montantDevise String?
  titulaireNom  String?
  // Capacité future uniquement — même règle que AvisMarche.acheteurId.
  titulaireId   String?
  titulaire     Acteur? @relation("LotTitulaire", fields: [titulaireId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cpvs             LotCpv[]
  // Phase 10 — voir modèle Projet plus bas.
  projetLinks      ProjetLot[]
  // Phase 11 — voir modèle DocumentSit plus bas.
  documentSitLinks DocumentSitLot[]
  // Phase 12 — voir modèle Besoin plus bas.
  besoinLinks      BesoinLot[]

  @@unique([avisMarcheId, numero])
  @@index([avisMarcheId])
  @@index([titulaireId])
}

// CPV du LOT — même raison d'être que AvisMarcheCpv (un lot peut avoir
// plusieurs codes CPV réels).
model LotCpv {
  id    String @id @default(cuid())
  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  code  String

  @@unique([lotId, code])
  @@index([lotId])
}

// Phase 10 — Objet de travail interne permettant à Archiaccess de
// regrouper manuellement plusieurs éléments réels du SIT autour d'une
// opération, étude ou dossier. JAMAIS une donnée externe canonique :
// contrairement à AvisMarche/Site/Acteur (chacun réellement extrait
// d'une source publique), Projet n'a ni source ni sourceId — il est créé
// explicitement par un employé (createdBy), jamais déduit automatiquement
// d'un AvisMarche, d'un Site ou d'un Acteur (aucun des connecteurs
// actuels ne fournit d'identifiant de projet/opération exploitable, voir
// le rapport d'audit Phase 10 — validé par l'utilisateur). Les relations
// vers les objets réels (ProjetSite/ProjetActeur/ProjetAvisMarche/
// ProjetLot ci-dessous) résultent TOUJOURS d'une action explicite de
// l'utilisateur, jamais d'une résolution automatique par similarité de
// texte, adresse, montant ou acheteur — deux Projets proches peuvent
// parfaitement coexister sans être fusionnés.
model Projet {
  id          String    @id @default(cuid())
  nom         String
  // Texte libre volontairement — aucune taxonomie de types d'opération
  // fiable trouvée dans les sources actuelles (voir le rapport d'audit
  // Phase 10), jamais un enum inventé sans besoin réel démontré.
  type        String?
  statut      String?
  description String?
  dateDebut   DateTime?
  dateFin     DateTime?
  montant     Float?

  // Traçabilité de création (qui, quand) — pas une notion de propriété
  // exclusive, voir User.projetsCrees. Nullable + SetNull : un Projet
  // (dossier d'équipe partagé) ne doit jamais disparaître si son créateur
  // était un jour retiré, même si en pratique les comptes ne sont
  // aujourd'hui que désactivés, jamais supprimés (voir CLAUDE.md).
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites            ProjetSite[]
  acteurs          ProjetActeur[]
  avisMarches      ProjetAvisMarche[]
  lots             ProjetLot[]
  // Phase 11 — voir modèle DocumentSit plus bas.
  documentSitLinks DocumentSitProjet[]
  // Phase 12 — voir modèle Besoin plus bas.
  besoinLinks      BesoinProjet[]
}

// Rattachement Projet<->Site, action explicite uniquement (voir Projet
// ci-dessus). Pas de champ "rôle" : aucun besoin réel identifié pour un
// Site (contrairement à ProjetActeur ci-dessous) — jamais ajouté par
// anticipation.
model ProjetSite {
  id        String   @id @default(cuid())
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projetId, siteId])
  @@index([projetId])
  @@index([siteId])
}

// Rattachement Projet<->Acteur. role réutilise ActeurType (déjà en place,
// Phase 2 — MOA/MOE/bureau d'études/entreprise...) plutôt qu'une nouvelle
// taxonomie : c'est un rôle "réellement gérable proprement" au sens de la
// consigne Phase 10. Distinct de Acteur.type (classification globale de
// l'acteur, assignée une fois) : un même Acteur peut jouer des rôles
// différents selon le projet — role reste donc propre à CETTE relation,
// jamais copié depuis Acteur.type.
model ProjetActeur {
  id        String      @id @default(cuid())
  projetId  String
  projet    Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  acteurId  String
  acteur    Acteur      @relation(fields: [acteurId], references: [id], onDelete: Cascade)
  role      ActeurType?
  createdAt DateTime    @default(now())

  @@unique([projetId, acteurId])
  @@index([projetId])
  @@index([acteurId])
}

// Rattachement Projet<->AvisMarche (Phase 9). Aucune résolution
// automatique (référence antérieure, objet, acheteur, localisation —
// tous étudiés et écartés comme signaux fiables, voir le rapport d'audit
// Phase 10) : uniquement une action explicite de l'utilisateur pendant sa
// recherche.
model ProjetAvisMarche {
  id           String     @id @default(cuid())
  projetId     String
  projet       Projet     @relation(fields: [projetId], references: [id], onDelete: Cascade)
  avisMarcheId String
  avisMarche   AvisMarche @relation(fields: [avisMarcheId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([projetId, avisMarcheId])
  @@index([projetId])
  @@index([avisMarcheId])
}

// Rattachement Projet<->Lot (Phase 9), même principe que ProjetAvisMarche.
model ProjetLot {
  id        String   @id @default(cuid())
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projetId, lotId])
  @@index([projetId])
  @@index([lotId])
}

// Phase 11 — référentiel des types documentaires SIT (DCE/CCTP/...).
// Distinct de Document.sourceType (texte libre, corpus réglementaire du
// copilote) : celui-ci sert exclusivement DocumentSit ci-dessous.
enum DocumentSitType {
  DCE
  RC
  CCAP
  CCTP
  AE
  BPU
  DPGF
  ETUDE
  DIAGNOSTIC
  RAPPORT
  PLAN
  DOE
  PV
  OPR
  RESERVE
  COMPTE_RENDU
  PLANNING
}

// Phase 11 — domaine documentaire du SIT (DCE, CCTP, rapports, plans,
// PV... rattachés à un Site/Projet/Acteur/AvisMarche/Lot réel). SANS
// AUCUN RAPPORT avec le modèle `Document` ci-dessus (corpus réglementaire
// indexé pour le copilote, pgvector) — nom volontairement distinct pour
// éviter toute collision Prisma ou sémantique, voir le rapport d'audit
// Phase 11 (validé par l'utilisateur). `Document`/`DocumentChunk`
// restent strictement inchangés par cette phase.
//
// Provenance jamais inventée (voir lib/data-sources/boamp.ts et le
// rapport d'audit Phase 11) : aucune source actuelle ne fournit de
// fichier réellement téléchargeable — BOAMP/BODACC ne donnent que des
// URL de portail ou de page de détail, jamais un lien direct vers un
// fichier. source="manuel" est donc le cas normal ; source="boamp" ne
// doit être utilisé que si une référence BOAMP réelle existe (ex.
// sourceUrl = url_avis réel), jamais une URL de fichier fabriquée.
//
// storageKey prépare une future évolution de stockage binaire
// (lib/storage.ts reste markdown-only dans cette phase, voir CLAUDE.md)
// — sa présence ne doit jamais être interprétée comme "le fichier existe
// réellement", seulement comme une référence prête pour cette évolution.
//
// Pas de DocumentVersion : aucun besoin réel démontré à ce stade (voir
// le rapport d'audit) — une évolution du contenu se traduit par
// updatedAt, jamais par un historique de versions tant que ce besoin
// n'est pas prouvé. Pas de contenuExtrait rempli automatiquement : aucun
// OCR/parsing/chunking/embedding n'est implémenté dans cette phase.
model DocumentSit {
  id          String           @id @default(cuid())
  titre       String
  type        DocumentSitType?
  description String?

  // Provenance — voir le commentaire du modèle ci-dessus. Tous nullables :
  // un document créé manuellement par un employé (cas normal) n'a ni
  // source ni sourceId ni sourceUrl.
  source      String?
  sourceId    String?
  sourceUrl   String?
  retrievedAt DateTime?

  checksum     String?
  mimeType     String?
  // BigInt — même convention que DatasetManifest.originalSizeBytes
  // (taille de fichier, jamais bornée à Int32).
  tailleOctets BigInt?
  dateDocument DateTime?

  // Référence vers un futur objet de stockage binaire — voir le
  // commentaire du modèle ci-dessus. Jamais interprété comme "le fichier
  // est réellement stocké" ailleurs dans le code applicatif.
  storageKey String?

  // Texte déjà extrait par une source (jamais produit par ce système —
  // aucun OCR/parsing implémenté ici, voir le rapport d'audit Phase 11).
  contenuExtrait   String?
  contenuExtraitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites       DocumentSitSite[]
  projets     DocumentSitProjet[]
  avisMarches DocumentSitAvisMarche[]
  lots        DocumentSitLot[]
  acteurs     DocumentSitActeur[]
  // Phase 12 — voir modèle Besoin plus bas.
  besoinLinks BesoinDocumentSit[]
}

// Rattachement DocumentSit<->Site — action explicite uniquement, même
// principe que ProjetSite (Phase 10). Pas de relation directe vers
// Parcelle/BatimentPhysique/Unite/DPE : déjà accessibles via Site.
model DocumentSitSite {
  id            String      @id @default(cuid())
  documentSitId String
  documentSit   DocumentSit @relation(fields: [documentSitId], references: [id], onDelete: Cascade)
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([documentSitId, siteId])
  @@index([documentSitId])
  @@index([siteId])
}

// Rattachement DocumentSit<->Projet (Phase 10).
model DocumentSitProjet {
  id            String      @id @default(cuid())
  documentSitId String
  documentSit   DocumentSit @relation(fields: [documentSitId], references: [id], onDelete: Cascade)
  projetId      String
  projet        Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([documentSitId, projetId])
  @@index([documentSitId])
  @@index([projetId])
}

// Rattachement DocumentSit<->AvisMarche (Phase 9).
model DocumentSitAvisMarche {
  id            String      @id @default(cuid())
  documentSitId String
  documentSit   DocumentSit @relation(fields: [documentSitId], references: [id], onDelete: Cascade)
  avisMarcheId  String
  avisMarche    AvisMarche  @relation(fields: [avisMarcheId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([documentSitId, avisMarcheId])
  @@index([documentSitId])
  @@index([avisMarcheId])
}

// Rattachement DocumentSit<->Lot (Phase 9).
model DocumentSitLot {
  id            String      @id @default(cuid())
  documentSitId String
  documentSit   DocumentSit @relation(fields: [documentSitId], references: [id], onDelete: Cascade)
  lotId         String
  lot           Lot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([documentSitId, lotId])
  @@index([documentSitId])
  @@index([lotId])
}

// Rattachement DocumentSit<->Acteur (Phase 2/8).
model DocumentSitActeur {
  id            String      @id @default(cuid())
  documentSitId String
  documentSit   DocumentSit @relation(fields: [documentSitId], references: [id], onDelete: Cascade)
  acteurId      String
  acteur        Acteur      @relation(fields: [acteurId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([documentSitId, acteurId])
  @@index([documentSitId])
  @@index([acteurId])
}

// Phase 12 — Besoin : une nécessité métier/technique explicitement
// identifiée (étude structure, mission OPC, diagnostic, travaux de
// façade, maintenance...), TOUJOURS créée par un employé — voir l'audit
// Phase 12 (validé par l'utilisateur) : aucune source externe du dépôt
// (BOAMP/BODACC/aucun connecteur) ne fournit d'objet "besoin" identifiable,
// même constat que Projet en Phase 10. Un Besoin n'est ni un document, ni
// un lot, ni un projet, ni une discipline, ni une entreprise : ce sont
// des objets distincts reliés au besoin par les tables de jointure
// ci-dessous, toujours par une action explicite de l'utilisateur.
//
// type/discipline/problematique/typeOuvrage/statut : texte libre
// volontairement (String?), jamais un enum — vérifié à l'audit : aucune
// taxonomie stable réutilisable n'existe dans ce dépôt (la "taxonomie des
// ~40 disciplines techniques Archiaccess", app/sit/page.tsx::TAXONOMY,
// est un contenu d'affichage UI en phrases longues avec parenthèses,
// jamais des identifiants d'enum valides, et volontairement qualifiée de
// "savoir-faire d'ingénierie, pas une donnée interrogeable" dans son
// propre commentaire — la forcer en enum aurait fabriqué une taxonomie
// qui n'existe nulle part ailleurs dans le code). ActeurType (Phase 2)
// n'est pas réutilisé pour `type` : il décrit un RÔLE D'ACTEUR (qui fait
// quoi), pas une CATÉGORIE DE BESOIN (quoi faire) — les réutiliser
// ensemble aurait été l'ambiguïté sémantique explicitement proscrite par
// la consigne Phase 12.
//
// Pas de createdBy/createdById ici (à la différence de Projet, Phase 10)
// : absent de la liste de champs minimale demandée pour cette phase,
// jamais ajouté sans nécessité démontrée.
model Besoin {
  id            String  @id @default(cuid())
  titre         String
  description   String?
  statut        String?
  type          String?
  discipline    String?
  problematique String?
  typeOuvrage   String?

  // Provenance — même discipline que DocumentSit (Phase 11) : tous
  // nullables, jamais inventée. source="manuel" est le cas normal (aucune
  // source externe ne fournit de Besoin, voir ci-dessus).
  source      String?
  sourceId    String?
  sourceUrl   String?
  retrievedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites        BesoinSite[]
  projets      BesoinProjet[]
  acteurs      BesoinActeur[]
  avisMarches  BesoinAvisMarche[]
  lots         BesoinLot[]
  documentsSit BesoinDocumentSit[]
}

// Rattachement Besoin<->Site — action explicite uniquement, même pattern
// que ProjetSite/DocumentSitSite (Phase 10/11). Pas de relation directe
// vers Parcelle/BatimentPhysique/Unite/DPE : déjà accessibles via Site.
model BesoinSite {
  id        String   @id @default(cuid())
  besoinId  String
  besoin    Besoin   @relation(fields: [besoinId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([besoinId, siteId])
  @@index([besoinId])
  @@index([siteId])
}

// Rattachement Besoin<->Projet (Phase 10).
model BesoinProjet {
  id        String   @id @default(cuid())
  besoinId  String
  besoin    Besoin   @relation(fields: [besoinId], references: [id], onDelete: Cascade)
  projetId  String
  projet    Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([besoinId, projetId])
  @@index([besoinId])
  @@index([projetId])
}

// Rattachement Besoin<->Acteur (Phase 2/8).
model BesoinActeur {
  id        String   @id @default(cuid())
  besoinId  String
  besoin    Besoin   @relation(fields: [besoinId], references: [id], onDelete: Cascade)
  acteurId  String
  acteur    Acteur   @relation(fields: [acteurId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([besoinId, acteurId])
  @@index([besoinId])
  @@index([acteurId])
}

// Rattachement Besoin<->AvisMarche (Phase 9).
model BesoinAvisMarche {
  id           String     @id @default(cuid())
  besoinId     String
  besoin       Besoin     @relation(fields: [besoinId], references: [id], onDelete: Cascade)
  avisMarcheId String
  avisMarche   AvisMarche @relation(fields: [avisMarcheId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([besoinId, avisMarcheId])
  @@index([besoinId])
  @@index([avisMarcheId])
}

// Rattachement Besoin<->Lot (Phase 9) — cardinalité N:N confirmée par la
// consigne Phase 12 elle-même : un lot peut contenir plusieurs besoins,
// un besoin peut concerner plusieurs lots. Lot et Besoin restent deux
// objets distincts, jamais confondus.
model BesoinLot {
  id        String   @id @default(cuid())
  besoinId  String
  besoin    Besoin   @relation(fields: [besoinId], references: [id], onDelete: Cascade)
  lotId     String
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([besoinId, lotId])
  @@index([besoinId])
  @@index([lotId])
}

// Rattachement Besoin<->DocumentSit (Phase 11B) — jamais Document/
// DocumentChunk (corpus réglementaire/RAG, hors périmètre). Un besoin
// n'est jamais déduit automatiquement d'un DocumentSit : uniquement une
// action explicite de l'utilisateur.
model BesoinDocumentSit {
  id            String      @id @default(cuid())
  besoinId      String
  besoin        Besoin      @relation(fields: [besoinId], references: [id], onDelete: Cascade)
  documentSitId String
  documentSit   DocumentSit @relation(fields: [documentSitId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([besoinId, documentSitId])
  @@index([besoinId])
  @@index([documentSitId])
}

// Moteur d'ingestion national (voir CLAUDE.md et l'audit du 2026-09-12,
// "transformation en data platform") — par opposition au coffre
// (DataCacheEntry ci-dessous, une entrée = une recherche ponctuelle d'un
// employé), IngestionJob suit un traitement en masse qui tourne pour son
// propre compte, sans utilisateur derrière : téléchargement d'un fichier
// bulk officiel, itération exhaustive d'une API à cardinalité bornée...
// Une ligne = une partition technique d'une source (ex: la phase
// "download" du stock SIRENE, ou une tranche de communes Géorisques) —
// jamais une notion de priorité métier. Le détail de la reprise (curseur,
// offset, dernier code INSEE traité...) est propre à chaque runner et
// vit dans checkpoint (JSON), pas dans des colonnes dédiées : ça évite une
// migration à chaque nouvelle source.
enum IngestionStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model IngestionJob {
  id        String @id @default(cuid())
  source    String // "sirene", "georisques"...
  dataset   String // "stock-etablissement", "risques-communes"...
  partition String // "download", "process", "communes:00000-05000"... — unité de reprise, jamais une zone privilégiée

  // Millésime/version réelle constatée à la source (ex: "20260901" pour
  // le fichier StockEtablissement) — traçabilité, jamais déduit.
  datasetVersion String?

  status          IngestionStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  lastHeartbeatAt DateTime?

  // État de reprise propre au runner (ex: { phase: "download", bytesDownloaded, totalBytes }
  // ou { phase: "process", rowsSkipped, rowsProcessed } pour SIRENE ; { lastCodeInsee } pour Géorisques).
  checkpoint Json?

  recordsRead      Int @default(0)
  recordsProcessed Int @default(0)
  recordsInserted  Int @default(0)
  recordsUpdated   Int @default(0)
  recordsRejected  Int @default(0)

  errorCount Int       @default(0)
  lastError  String?
  retryCount Int       @default(0)
  nextRunAt  DateTime? // backoff : ne pas retenter avant cette date après une erreur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une même partition d'une source ne doit jamais avoir deux jobs
  // concurrents — reprise = mise à jour de la même ligne, jamais une
  // nouvelle ligne.
  @@unique([source, dataset, partition])
  @@index([source, status])
}

enum ManifestStatus {
  PENDING
  STAGING
  PREPROCESSING
  READY
  FAILED
}

enum ChunkStatus {
  PENDING
  INGESTED
  FAILED
}

// Remplace la stratégie "redécompresser depuis le début + ignorer N
// lignes déjà traitées" (Phase 3, voir CLAUDE.md — le test SIRENE a
// démontré qu'elle ne tient pas à l'échelle nationale, ~30M lignes).
// Un DatasetManifest = un millésime précis d'un fichier bulk officiel
// volumineux (ZIP contenant un seul gros CSV) : le fichier original est
// décompressé UNE SEULE FOIS, découpé en chunks CSV.gz indépendants,
// rejouables et idempotents — le checkpoint d'ingestion devient alors
// "quel chunk, quelle ligne dans ce chunk", jamais "combien de lignes
// ignorer depuis le tout début". Sert aussi de source de vérité pour
// "quelle version est chargée, quels chunks manquent" (observabilité).
model DatasetManifest {
  id                String         @id @default(cuid())
  source            String
  dataset           String
  datasetVersion    String // millésime réel constaté à la source (jamais deviné)
  sourceUrl         String
  retrievedAt       DateTime       @default(now())
  originalChecksum  String?
  // BigInt : les fichiers stock SIRENE dépassent 2^31 octets (StockEtablissement
  // ≈ 2,87 Go) — un Int 32 bits déborderait silencieusement.
  originalSizeBytes BigInt
  chunkTargetRows   Int // lignes/chunk visé au découpage — configurable, voir lib/ingestion/types.ts
  totalChunks       Int?
  totalRows         Int? // connu seulement une fois le découpage terminé
  status            ManifestStatus @default(PENDING)
  lastError         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  chunks DatasetChunk[]

  // Une même version d'un dataset ne doit jamais être découpée deux fois
  // — un millésime suivant crée un nouveau manifeste, jamais une
  // réécriture du précédent (traçabilité : on doit pouvoir répondre
  // "quelle version était chargée avant").
  @@unique([source, dataset, datasetVersion])
  @@index([source, dataset])
}

model DatasetChunk {
  id             String          @id @default(cuid())
  manifestId     String
  manifest       DatasetManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  s3Key          String
  checksum       String
  byteSize       Int
  rowCount       Int?
  status         ChunkStatus     @default(PENDING)
  // Dernière ligne traitée AU SEIN de ce chunk (pas depuis le début du
  // fichier) — reprise bornée à la taille d'un chunk, jamais à celle du
  // fichier national entier.
  rowOffset      Int             @default(0)
  ingestionJobId String?
  ingestedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@unique([manifestId, chunkIndex])
  @@index([manifestId, status])
}

// Structure à l'échelle nationale la donnée déjà réelle de
// lib/data-sources/georisques.ts (type CommuneRisks) — même principe que
// Site/Acteur : aucune nouvelle source, une couche relationnelle sur ce
// qui est déjà vérifié réel. Clé = codeInsee (donnée communale) : une
// commune peut être couverte par l'ingestion nationale sans qu'aucune
// adresse de cette commune n'ait jamais été recherchée via "Site" —
// jamais forcé dans une relation à Site pour ne pas fabriquer un lien
// qui n'existe pas.
model Risque {
  id             String   @id @default(cuid())
  codeInsee      String   @unique
  commune        String
  risks          Json // Risk[] tel que retourné par georisques.ts — jamais reformaté/deviné
  seismicZone    String?
  radonPotential String?
  retrievedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([codeInsee])
}

// "Coffre" du SIT — voir CLAUDE.md, décision utilisateur du 2026-08-31 :
// chaque recherche (cadastre, DVF, entreprises, urbanisme, DPE, BODACC,
// Géorisques, adresse) interroge TOUJOURS la source en direct (données à
// jour), mais le résultat est systématiquement conservé ici — jamais
// supprimé, jamais purgé automatiquement. Sert de mémoire permanente
// ("second cerveau" des données brutes, par opposition à celui des
// documents/études ci-dessus) et de repli si une API externe tombe en
// panne. Une seule table générique pour toutes les sources, présentes et
// futures, plutôt qu'un modèle par connecteur — reste léger à faire
// évoluer.
model DataCacheEntry {
  id        String   @id @default(cuid())
  source    String // ex: "cadastre", "dvf", "entreprises", "urbanisme", "dpe", "bodacc", "georisques", "ban"
  cacheKey  String // ex: coordonnées arrondies, SIREN, code INSEE...
  payload   Json // réponse normalisée du connecteur (le même type que celui-ci retourne à l'appelant)
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([source, cacheKey])
  @@index([source])
}
