// Archiaccess AI — Système d'Information Technique Fédéré
// Comptes employés individuels (remplace le mot de passe d'équipe partagé,
// voir CLAUDE.md) + copilote conversationnel + "second cerveau" du copilote
// (Document/DocumentChunk indexés via pgvector, voir CLAUDE.md). Le hub de
// données structurées (foncier, financier, réglementaire par
// adresse/parcelle) n'a pas encore de modèle — pas anticipé tant que les
// connecteurs eux-mêmes n'existent pas.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // postgis ajouté Phase 3 (2026-09-13) — vérifié compatible en local
  // avec vector (coexistent sans conflit, Postgres 16). Compatibilité
  // RDS réelle non vérifiée cette session (pas d'accès réseau à
  // l'instance) mais officiellement supportée par RDS Postgres — à
  // confirmer avant déploiement (voir le rapport).
  extensions = [vector, postgis]
}

// Compte employé individuel — remplace le mot de passe d'équipe partagé
// (voir CLAUDE.md, décision utilisateur du 2026-08-30). Créés uniquement
// par un admin (pas d'auto-inscription) : voir app/api/admin/users. Le
// tout premier compte s'auto-crée via /api/auth/bootstrap tant qu'aucun
// utilisateur n'existe encore (sinon personne ne pourrait créer le premier
// admin).
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String
  isAdmin            Boolean  @default(false)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  sessions      Session[]
  conversations Conversation[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

enum MessageRole {
  USER
  ASSISTANT
}

// "Second cerveau" du copilote — voir CLAUDE.md : pgvector sur cette même
// base + S3 pour le contenu brut, pas de service de base vectorielle
// séparé. Le Markdown reste le format de sortie des études ; ces modèles
// ne font qu'indexer ce contenu pour la recherche par similarité, jamais
// ne le remplacent.
model Document {
  id         String   @id @default(cuid())
  title      String
  sourceType String // ex: "etude", "reglementaire", "note" — pas d'enum figé tant que le hub de données n'a pas défini ses propres catégories
  s3Key      String // chemin du fichier Markdown source dans le bucket documents
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chunks DocumentChunk[]
}

model DocumentChunk {
  id         String                       @id @default(cuid())
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  // Dimension 1024 = celle de mistral-embed, vérifiée par appel réel à
  // l'API (voir CLAUDE.md) plutôt que supposée. Prisma ne modélise pas
  // nativement le type vector : Unsupported() le laisse de côté côté
  // client, les insertions/recherches par similarité passeront par du
  // SQL brut ($queryRaw / $executeRaw) avec l'opérateur pgvector <=>.
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now())

  @@index([documentId])
}

// Référentiel territorial du SIT (Phase 1 : Site/Localisation/Parcelle/
// Bâtiment — voir CLAUDE.md et l'audit du 2026-09-11). Contrairement à
// DataCacheEntry ci-dessous (blobs JSON opaques par connecteur, sans lien
// entre eux), ces modèles structurent et relient la donnée déjà
// réellement récupérée par les connecteurs existants (lib/data-sources/*)
// — aucune nouvelle source de données introduite ici, uniquement une
// couche relationnelle par-dessus ce qui est déjà vérifié réel. Un champ
// nullable resté vide signifie "aucune source réelle ne le fournit
// actuellement", jamais une valeur à deviner côté UI.

// Un SITE = un emplacement précis déjà étudié (adresse sélectionnée via
// "Recherche"). Créé/mis à jour à la sélection d'une adresse
// (selectAddress(), app/sit/page.tsx) — jamais créé à vide.
model Site {
  id        String                                @id @default(cuid())
  label     String // AddressResult.label (BAN) — ex: "12 rue de Vesle, 51100 Reims"
  citycode  String // code INSEE (BAN)
  postcode  String
  city      String
  longitude Float
  latitude  Float
  // Colonne géométrique additive (Phase 3, PostGIS) — longitude/latitude
  // restent la source de vérité et ne sont jamais retirées (compatibilité
  // préservée) ; geom est backfillée depuis ces deux colonnes et tenue à
  // jour par le code applicatif à chaque upsert. SRID 4326 = WGS84,
  // cohérent avec les coordonnées déjà produites par tous les connecteurs
  // existants. Unsupported() : Prisma ne modélise pas nativement le type
  // geometry (même principe que Unsupported("vector(1024)") sur
  // DocumentChunk.embedding) — accès via $queryRaw/$executeRaw.
  geom      Unsupported("geometry(Point, 4326)")?
  createdAt DateTime                              @default(now())
  updatedAt DateTime                              @updatedAt

  parcelleLinks  SiteParcelle[]
  batiments      Batiment[]
  sources        SiteSource[]
  etablissements Etablissement[] // Phase 2 — voir modèle Etablissement plus bas

  // Une même adresse recherchée plusieurs fois ne doit pas créer plusieurs
  // sites — un seul enregistrement mis à jour dans le temps.
  @@unique([citycode, label])
  @@index([citycode])
}

// Comment une relation Site<->Parcelle a été obtenue — jamais présentée
// comme une certitude administrative quand elle ne l'en est pas une
// (Phase 4.5, voir CLAUDE.md et le rapport de consolidation). Vérifié
// réellement : aucun identifiant commun BAN/Cadastre n'existe dans les
// données officielles (le fichier bulk Cadastre ne porte aucune référence
// BAN) — DETERMINISTIC reste donc réservé pour un futur identifiant
// commun qu'aucune source actuelle ne fournit, jamais utilisé aujourd'hui.
// Deux méthodes spatiales RÉELLEMENT distinctes coexistent (mesure Phase
// 4.5, voir le rapport) : la recherche ponctuelle (apicarto, Phase 1)
// interroge une emprise (bbox ~20 m) autour du point et peut légitimement
// renvoyer PLUSIEURS parcelles proches sans garantie de containment exact
// (SPATIAL_NEARBY, distanceMeters renseignée quand mesurable) ; l'ingestion
// bulk (Phase 4) vérifie un containment géométrique exact via ST_Contains
// (SPATIAL_CONTAINS, fiable mais jamais présenté comme une certitude
// administrative pour autant).
enum SiteParcelleRelationMethod {
  SPATIAL_CONTAINS
  SPATIAL_NEARBY
  DETERMINISTIC
}

// Relation explicite Site<->Parcelle (Phase 4.5 — remplace l'ancien
// Parcelle.siteId scalaire, qui plafonnait une Parcelle à au plus un Site
// alors que la donnée réelle contredit cette hypothèse : une parcelle
// cadastrale contient très couramment plusieurs adresses BAN distinctes
// (immeuble collectif, lotissement...), et la recherche à la demande
// (apicarto, bbox) peut légitimement faire correspondre un Site à
// plusieurs parcelles voisines. Mesuré réellement avant cette évolution
// (voir le rapport) plutôt que supposé.
//
// Cas ambigu (un même Site géométriquement contenu par DEUX parcelles
// distinctes — constaté réellement, jamais hypothétique, voir le
// rapport Phase 4) : AUCUNE sélection arbitraire. Les DEUX candidates
// sont conservées avec ambiguous=true, visibles en observabilité
// qualité, plutôt que silencieusement résolues à une seule ou omises.
// Une relation résolue avec certitude a toujours ambiguous=false, et
// c'est alors la SEULE ligne SPATIAL_CONTAINS pour ce Site.
model SiteParcelle {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parcelleId String
  parcelle   Parcelle @relation(fields: [parcelleId], references: [id], onDelete: Cascade)

  relationMethod SiteParcelleRelationMethod
  ambiguous      Boolean                    @default(false)
  // Distance réelle (mètres) entre le point du Site et la géométrie de la
  // Parcelle — non pertinente pour SPATIAL_CONTAINS (le point est déjà
  // dans le polygone, toujours 0/null), mesurée pour SPATIAL_NEARBY
  // (résultat d'une recherche par emprise, jamais un containment garanti).
  // Laissée null pour les relations historiques migrées sans cette mesure
  // (voir la migration) plutôt que fabriquée rétroactivement.
  distanceMeters Float?

  source      String // "cadastre-etalab-bulk" (résolution différée, Phase 4.5) | "cadastre-apicarto" (à la demande, Phase 1)
  retrievedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Une paire (Site, Parcelle) n'a jamais plus d'une ligne — un
  // recalcul idempotent met à jour la ligne existante (ex: ambiguous)
  // plutôt que d'en créer une nouvelle.
  @@unique([siteId, parcelleId])
  @@index([siteId])
  @@index([parcelleId])
}

// Structure la donnée réelle du Cadastre — deux sources possibles,
// distinguées par `source` : l'API à la demande (apicarto, Phase 1,
// lib/data-sources/cadastre.ts) et l'ingestion bulk (Etalab/DGFiP,
// Phase 4, lib/ingestion/sources/cadastre.ts). Mêmes champs partagés,
// enrichis Phase 4 avec la provenance explicite (D du brief) — jamais
// aveuglément toutes les colonnes du fichier source. La relation vers
// Site vit désormais dans SiteParcelle (Phase 4.5, voir ci-dessus) — plus
// de siteId scalaire ici, une Parcelle pouvant réellement être associée à
// plusieurs Sites (mesuré, jamais supposé).
model Parcelle {
  id String @id @default(cuid())

  idu            String // identifiant cadastral officiel complet (ex: "514540000T0266") — jamais recomposé nous-mêmes quand fourni tel quel par la source
  section        String
  sectionPrefixe String
  numero         String
  contenanceM2   Float
  codeInsee      String
  // Nom de commune : absent du fichier bulk Etalab (seul le code INSEE y
  // figure, voir le rapport) — résolu via la même liste officielle réelle
  // que BAN/Géorisques (geo.api.gouv.fr), jamais fabriqué ; peut rester
  // vide si la résolution échoue.
  commune        String?
  geometry       Json // GeoJSON réel (Polygon ou MultiPolygon selon la source — jamais approximé)
  // Toujours normalisée en MultiPolygon via ST_Multi() à l'écriture (la
  // source bulk donne des Polygon simples) — colonne additive, voir
  // Site.geom (Phase 3).
  geom           Unsupported("geometry(MultiPolygon, 4326)")?

  // Provenance explicite (Phase 4, section D du brief) — jamais mélangée
  // entre les deux sources possibles.
  source         String? // "cadastre-apicarto" (Phase 1, à la demande) | "cadastre-etalab-bulk" (Phase 4)
  dataset        String? // ex: "parcelles"
  datasetVersion String? // millésime réel de la source bulk (ex: "2026-06-01")
  retrievedAt    DateTime?

  siteLinks SiteParcelle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idu])
  @@index([codeInsee])
}

// Structure la donnée déjà réelle de lib/data-sources/dpe.ts (type
// DpeRecord) — seule source réelle disponible pour "bâtiment" à ce jour.
//
// ATTENTION SÉMANTIQUE (Phase 5, voir le rapport) : ce modèle représente
// en réalité une UNITÉ/LOGEMENT diagnostiquée par un DPE, PAS un bâtiment
// physique — vérifié réellement sur des données ADEME (un même bâtiment
// physique peut porter des dizaines de DPE réels distincts, un cas réel
// observé en comptant 101). Le nom "Batiment" est conservé pour l'instant
// (aucune migration de renommage exécutée) le temps de valider une
// source de bâtiment physique fiable (RNB — Référentiel National des
// Bâtiments, api.gouv.fr — vérifiée réellement Phase 5B, voir le
// rapport : fournit un identifiant natif stable "rnb_id", une géométrie
// réelle, et des références déterministes vers Cadastre "plots" et BAN
// "addresses" ; cardinalité Bâtiment↔Parcelle et Bâtiment↔Site mesurées
// réellement N:N sur un département entier). Aucune entité Bâtiment
// physique n'est encore modélisée — ne pas fabriquer ce niveau par
// regroupement d'adresses.
//
// anneeConstruction EXISTE réellement dans la source ADEME (vérifié
// Phase 5B — présent et rempli dans ~81 % des DPE réels inspectés) et
// est désormais réellement renseigné par lib/data-sources/dpe.ts et
// app/api/sit/sites/route.ts — un commentaire précédent ici affirmant le
// contraire était obsolète.
model Batiment {
  id                String   @id @default(cuid())
  siteId            String
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // Nullable en théorie (une future source non-DPE pourrait ne pas en
  // avoir), mais toujours renseigné en pratique aujourd'hui — seule
  // source réelle actuelle (lib/data-sources/dpe.ts) le fournit toujours.
  // @unique : identifiant national ADEME, permet un upsert idempotent
  // plutôt que de dupliquer la ligne à chaque nouvelle recherche de la
  // même adresse.
  numeroDpe         String?  @unique
  typeBatiment      String?
  surfaceHabitable  Float?
  etiquetteEnergie  String?
  etiquetteGes      String?
  anneeConstruction Int?
  createdAt         DateTime @default(now())

  @@index([siteId])
}

// Traçabilité (brief, section "Sources") : une ligne par connecteur déjà
// interrogé avec succès pour ce site, pour pouvoir afficher "Source :
// DVF, récupéré le [date]" plutôt qu'une donnée sans provenance.
model SiteSource {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source    String // même vocabulaire que DataCacheEntry.source ("cadastre", "dvf", "dpe"...)
  fetchedAt DateTime @default(now())

  @@unique([siteId, source])
  @@index([siteId])
}

// Référentiel des acteurs du SIT (Phase 2 — voir audit du 2026-09-12).
// Même principe que Site/Parcelle/Batiment : structure et relie la
// donnée déjà réellement récupérée par lib/data-sources/entreprises.ts
// (SIRENE) et lib/data-sources/bodacc.ts — aucune nouvelle source. Un
// champ nullable signifie "aucune source réelle ne le fournit
// actuellement", jamais une valeur devinée.

// Aucune source publique ne permet de déduire ce qu'est une entreprise
// pour un projet donné (architecte, AMO, entreprise générale...) — ce
// n'est jamais assigné automatiquement, seulement par un humain, plus
// tard (pas d'interface d'assignation construite dans cette phase).
enum ActeurType {
  ARCHITECTE
  BUREAU_ETUDES
  AMO
  OPC
  ECONOMISTE
  GEOMETRE
  CONTROLEUR_TECHNIQUE
  COORDONNATEUR_SPS
  DIAGNOSTIQUEUR
  ENTREPRISE_GENERALE
  ENTREPRISE_SPECIALISEE
  FOURNISSEUR
  FABRICANT
  PROMOTEUR
  MAITRE_OUVRAGE
  ACHETEUR_PUBLIC
}

// Un ACTEUR = une entreprise (SIRENE) déjà rencontrée dans une recherche
// (recherche universelle "Recherche", catégorie ACTEUR). Identifié par
// SIREN (stable, national).
model Acteur {
  id                  String      @id @default(cuid())
  siren               String      @unique
  // Nullable : reste vide pour un Acteur connu seulement via
  // StockEtablissement (pas de dénomination à ce niveau) tant que
  // StockUniteLegale ne l'a pas encore renseigné, ou pour de rares
  // unités légales réellement purgées côté INSEE. Une fois
  // StockUniteLegale ingéré (Phase 3, 2026-09-12), rempli pour la quasi-
  // totalité des SIREN réels : denominationUniteLegale pour une personne
  // morale, prénom+nom pour une personne physique (entrepreneur
  // individuel) — jamais de valeur fabriquée pour combler l'absence
  // résiduelle. Voir lib/ingestion/sources/sirene.ts.
  nom                 String?
  nomCommercial       String?
  codeNaf             String?
  // A/C ("actif"/"cessé") — vocabulaire de l'unité légale (StockUniteLegale
  // ou l'API de recherche ponctuelle, même niveau), distinct du A/F de
  // l'établissement (voir Etablissement.actif).
  statut              String?
  dateCreation        String?
  // Champs réellement utiles au SIT depuis StockUniteLegale (D du brief
  // Phase 3) — pas une reprise aveugle de toutes les colonnes SIRENE.
  categorieJuridique  String? // code INSEE (ex: "1000" = entrepreneur individuel, "5710" = SAS...)
  categorieEntreprise String? // PME/ETI/GE — déjà capté par lib/data-sources/entreprises.ts mais jamais persisté jusqu'ici
  trancheEffectifs    String? // tranche d'effectifs salariés (code INSEE)
  type                ActeurType?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  etablissements Etablissement[]
  sources        ActeurSource[]
}

// Structure lib/data-sources/entreprises.ts::Company.siege une fois
// étendu (code postal, commune, coordonnées — présents dans l'API mais
// ignorés jusqu'ici, voir l'audit Phase 2). Un seul établissement par
// entreprise pour l'instant (le siège) : l'API de recherche ne renvoie
// pas la liste complète des établissements sans un appel dédié non
// encore vérifié.
model Etablissement {
  id         String   @id @default(cuid())
  acteurId   String
  acteur     Acteur   @relation(fields: [acteurId], references: [id], onDelete: Cascade)
  siret      String   @unique
  adresse    String?
  codePostal String?
  codeInsee  String?
  commune    String?
  latitude   Float?
  longitude  Float?
  estSiege   Boolean  @default(false)
  actif      Boolean?
  // Résolu via lib/data-sources/ban.ts::searchAddress() sur l'adresse
  // SIRENE (même mécanisme que la persistance Site de la Phase 1) — pas
  // une correspondance de texte brute. Nullable tant que la résolution
  // n'a pas réussi ou n'a pas encore été tentée.
  siteId     String?
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([acteurId])
  @@index([siteId])
}

// Traçabilité — même principe que SiteSource.
model ActeurSource {
  id        String   @id @default(cuid())
  acteurId  String
  acteur    Acteur   @relation(fields: [acteurId], references: [id], onDelete: Cascade)
  source    String // "entreprises", "bodacc"...
  fetchedAt DateTime @default(now())

  @@unique([acteurId, source])
  @@index([acteurId])
}

// Moteur d'ingestion national (voir CLAUDE.md et l'audit du 2026-09-12,
// "transformation en data platform") — par opposition au coffre
// (DataCacheEntry ci-dessous, une entrée = une recherche ponctuelle d'un
// employé), IngestionJob suit un traitement en masse qui tourne pour son
// propre compte, sans utilisateur derrière : téléchargement d'un fichier
// bulk officiel, itération exhaustive d'une API à cardinalité bornée...
// Une ligne = une partition technique d'une source (ex: la phase
// "download" du stock SIRENE, ou une tranche de communes Géorisques) —
// jamais une notion de priorité métier. Le détail de la reprise (curseur,
// offset, dernier code INSEE traité...) est propre à chaque runner et
// vit dans checkpoint (JSON), pas dans des colonnes dédiées : ça évite une
// migration à chaque nouvelle source.
enum IngestionStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model IngestionJob {
  id        String @id @default(cuid())
  source    String // "sirene", "georisques"...
  dataset   String // "stock-etablissement", "risques-communes"...
  partition String // "download", "process", "communes:00000-05000"... — unité de reprise, jamais une zone privilégiée

  // Millésime/version réelle constatée à la source (ex: "20260901" pour
  // le fichier StockEtablissement) — traçabilité, jamais déduit.
  datasetVersion String?

  status          IngestionStatus @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  lastHeartbeatAt DateTime?

  // État de reprise propre au runner (ex: { phase: "download", bytesDownloaded, totalBytes }
  // ou { phase: "process", rowsSkipped, rowsProcessed } pour SIRENE ; { lastCodeInsee } pour Géorisques).
  checkpoint Json?

  recordsRead      Int @default(0)
  recordsProcessed Int @default(0)
  recordsInserted  Int @default(0)
  recordsUpdated   Int @default(0)
  recordsRejected  Int @default(0)

  errorCount Int       @default(0)
  lastError  String?
  retryCount Int       @default(0)
  nextRunAt  DateTime? // backoff : ne pas retenter avant cette date après une erreur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Une même partition d'une source ne doit jamais avoir deux jobs
  // concurrents — reprise = mise à jour de la même ligne, jamais une
  // nouvelle ligne.
  @@unique([source, dataset, partition])
  @@index([source, status])
}

enum ManifestStatus {
  PENDING
  STAGING
  PREPROCESSING
  READY
  FAILED
}

enum ChunkStatus {
  PENDING
  INGESTED
  FAILED
}

// Remplace la stratégie "redécompresser depuis le début + ignorer N
// lignes déjà traitées" (Phase 3, voir CLAUDE.md — le test SIRENE a
// démontré qu'elle ne tient pas à l'échelle nationale, ~30M lignes).
// Un DatasetManifest = un millésime précis d'un fichier bulk officiel
// volumineux (ZIP contenant un seul gros CSV) : le fichier original est
// décompressé UNE SEULE FOIS, découpé en chunks CSV.gz indépendants,
// rejouables et idempotents — le checkpoint d'ingestion devient alors
// "quel chunk, quelle ligne dans ce chunk", jamais "combien de lignes
// ignorer depuis le tout début". Sert aussi de source de vérité pour
// "quelle version est chargée, quels chunks manquent" (observabilité).
model DatasetManifest {
  id                String         @id @default(cuid())
  source            String
  dataset           String
  datasetVersion    String // millésime réel constaté à la source (jamais deviné)
  sourceUrl         String
  retrievedAt       DateTime       @default(now())
  originalChecksum  String?
  // BigInt : les fichiers stock SIRENE dépassent 2^31 octets (StockEtablissement
  // ≈ 2,87 Go) — un Int 32 bits déborderait silencieusement.
  originalSizeBytes BigInt
  chunkTargetRows   Int // lignes/chunk visé au découpage — configurable, voir lib/ingestion/types.ts
  totalChunks       Int?
  totalRows         Int? // connu seulement une fois le découpage terminé
  status            ManifestStatus @default(PENDING)
  lastError         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  chunks DatasetChunk[]

  // Une même version d'un dataset ne doit jamais être découpée deux fois
  // — un millésime suivant crée un nouveau manifeste, jamais une
  // réécriture du précédent (traçabilité : on doit pouvoir répondre
  // "quelle version était chargée avant").
  @@unique([source, dataset, datasetVersion])
  @@index([source, dataset])
}

model DatasetChunk {
  id             String          @id @default(cuid())
  manifestId     String
  manifest       DatasetManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  chunkIndex     Int
  s3Key          String
  checksum       String
  byteSize       Int
  rowCount       Int?
  status         ChunkStatus     @default(PENDING)
  // Dernière ligne traitée AU SEIN de ce chunk (pas depuis le début du
  // fichier) — reprise bornée à la taille d'un chunk, jamais à celle du
  // fichier national entier.
  rowOffset      Int             @default(0)
  ingestionJobId String?
  ingestedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@unique([manifestId, chunkIndex])
  @@index([manifestId, status])
}

// Structure à l'échelle nationale la donnée déjà réelle de
// lib/data-sources/georisques.ts (type CommuneRisks) — même principe que
// Site/Acteur : aucune nouvelle source, une couche relationnelle sur ce
// qui est déjà vérifié réel. Clé = codeInsee (donnée communale) : une
// commune peut être couverte par l'ingestion nationale sans qu'aucune
// adresse de cette commune n'ait jamais été recherchée via "Site" —
// jamais forcé dans une relation à Site pour ne pas fabriquer un lien
// qui n'existe pas.
model Risque {
  id             String   @id @default(cuid())
  codeInsee      String   @unique
  commune        String
  risks          Json // Risk[] tel que retourné par georisques.ts — jamais reformaté/deviné
  seismicZone    String?
  radonPotential String?
  retrievedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([codeInsee])
}

// "Coffre" du SIT — voir CLAUDE.md, décision utilisateur du 2026-08-31 :
// chaque recherche (cadastre, DVF, entreprises, urbanisme, DPE, BODACC,
// Géorisques, adresse) interroge TOUJOURS la source en direct (données à
// jour), mais le résultat est systématiquement conservé ici — jamais
// supprimé, jamais purgé automatiquement. Sert de mémoire permanente
// ("second cerveau" des données brutes, par opposition à celui des
// documents/études ci-dessus) et de repli si une API externe tombe en
// panne. Une seule table générique pour toutes les sources, présentes et
// futures, plutôt qu'un modèle par connecteur — reste léger à faire
// évoluer.
model DataCacheEntry {
  id        String   @id @default(cuid())
  source    String // ex: "cadastre", "dvf", "entreprises", "urbanisme", "dpe", "bodacc", "georisques", "ban"
  cacheKey  String // ex: coordonnées arrondies, SIREN, code INSEE...
  payload   Json // réponse normalisée du connecteur (le même type que celui-ci retourne à l'appelant)
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([source, cacheKey])
  @@index([source])
}
